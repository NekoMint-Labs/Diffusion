{
  "name": "diffusion-explorer",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A quiet thinking medium before commitment.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:offline": "node scripts/run-offline-tests.mjs",
    "test:e2e": "playwright test",
    "check:offline": "node scripts/offline-check.mjs && pnpm run typecheck:core && pnpm run check:locales && pnpm run test:offline && pnpm run check:source-size",
    "gateway": "tsx --env-file-if-exists=.env server/index.ts",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "snapshot": "python3 scripts/snapshot.py",
    "bench:spatial": "node --experimental-strip-types scripts/benchmark-spatial.mjs",
    "format:source": "node scripts/format-source.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "bench:storage": "node --experimental-strip-types scripts/benchmark-storage.mjs",
    "check:source-size": "node scripts/check-source-size.mjs",
    "build:discovery": "node scripts/build-discovery-sidecar.mjs",
    "prepare:licenses": "node scripts/prepare-distribution-licenses.mjs",
    "check:discovery": "node scripts/check-discovery-sidecar.mjs",
    "test:discovery": "node scripts/run-discovery-tests.mjs",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "bench:history": "node --expose-gc --experimental-strip-types scripts/benchmark-history.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@floating-ui/react": "^0.27.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^1.14.0",
    "@paper-design/shaders-react": "0.0.81",
    "@react-three/fiber": "9.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "dexie": "^4.0.11",
    "gsap": "^3.15.0",
    "hono": "^4.7.0",
    "motion": "^12.0.0",
    "ogl": "1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.180.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
