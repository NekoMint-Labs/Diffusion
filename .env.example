# Server-side only. Never prefix secrets with VITE_.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGIN=http://127.0.0.1:40000
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
# Optional comma-separated model ids the operator permits a client to request. Empty means the
# configured AI_MODEL only; the gateway never invents names.
AI_MODELS=
# Only `1` or `true` lets a client pick a model (still bounded by AI_MODELS when that list is set).
AI_ALLOW_MODEL_OVERRIDE=
# Explicit wire protocol; no silent model/endpoint probing or fallback calls.
AI_PROTOCOL=chat-completions
# Set to none for a compatible custom endpoint that rejects JSON mode.
AI_JSON_MODE=json-object
# Normalized HTTP discovery endpoint for the gateway. The desktop app uses its own bundled engine.
SEARCH_BASE_URL=
SEARCH_API_KEY=
# Set a strong token for any externally reachable gateway (>=24 characters).
GATEWAY_TOKEN=
# Optional public URL of the protected Diffusion gateway, never an upstream API.
VITE_GATEWAY_URL=
