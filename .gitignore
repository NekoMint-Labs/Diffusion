# Dependencies
node_modules/
.npm/
.pnpm-store/
.yarn/

# Build output
dist/
src-tauri/target/
src-tauri/gen/schemas/
*.tsbuildinfo
.vite/
coverage/

# Test output
playwright-report/
test-results/

# Local verification evidence: captured screenshots, motion recordings and proof files.
# Produced by scripts/capture-*.mjs and kept out of the repository, like dist/ and test-results/.
verification/

# Environment & secrets
.env
.env.*
!.env.example

# Bundled discovery engine. A build artifact, like dist/: produced by
# `pnpm run build:discovery`, copied into the installer by Tauri, and never committed. A committed
# binary would age silently and could not be verified against its source.
src-tauri/resources/discovery/
src-tauri/.discovery-build/

# Distribution license resources. Generated by `pnpm run prepare:licenses` (run automatically by
# `tauri build` before Tauri collects bundle resources) from the canonical retained license files.
# Committed copies would be a second source of truth that drifts from `LICENSE`,
# `internal/discovery-engine/LICENSE.smartsearch` and `docs/third_party/`.
src-tauri/resources/licenses/*
!src-tauri/resources/licenses/.gitkeep

# Python (scripts/snapshot.py)
__pycache__/
*.pyc

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs & archives
*.log
*.zip
.tmp/

# Windows download metadata
*:Zone.Identifier
